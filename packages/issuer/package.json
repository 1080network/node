{
  "name": "@1080network/mica-issuer",
  "version": "2.0.0-pre0",
  "description": "Mica network SDK for issuers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1080network/node.git",
    "directory": "packages/issuer"
  },
  "homepage": "https://mica.io/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@1080network/mica-common": "2.0.0-pre0",
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.0"
  }
}
