{
  "name": "@1080network/mica-common",
  "version": "2.0.0-pre0",
  "description": "Shared messages and the mutual TLS helper for the Mica network SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1080network/node.git",
    "directory": "packages/common"
  },
  "homepage": "https://mica.io/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/mtls.test.ts"
  },
  "devDependencies": {
    "@peculiar/x509": "^3.1.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.0"
  }
}
